<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Puente de Navi (Fase 7). Plantilla: instalar.sh cambia __PYTHON__, __PUENTE__, __HOME__ y __PATH__
  y la copia a ~/Library/LaunchAgents/com.christopher.navi.plist. No pongas claves aquí.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.christopher.navi</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__PUENTE__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PATH__</string>
    <key>BU_CDP_URL</key><string>http://127.0.0.1:9222</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>WorkingDirectory</key><string>__HOME__/.navi</string>
  <key>StandardOutPath</key><string>__HOME__/.navi/logs/puente.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.navi/logs/puente.err.log</string>
</dict>
</plist>
